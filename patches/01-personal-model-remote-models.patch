+    const initialBaseUrl = await baseUrl.inputValue();
+    const initialApiKey = await apiKey.inputValue();
+    await fetchModels.click();
+    const importDialog = page.getByRole("dialog", { name: "Select models to add" });
+    await importDialog.getByRole("checkbox", { name: "remote-b" }).click();
+    await importDialog.getByRole("button", { name: "Add 1 models" }).click();
+    await importDialog.waitFor({ state: "hidden" });
+    await page.getByText("remote-b", { exact: true }).waitFor();
+    assert.equal(await page.getByText("remote-a", { exact: true }).count(), 0);
+
+    await clearModels.click();
+    const confirm = page.getByRole("dialog", { name: "Clear all models?" });
+    await confirm.getByRole("button", { name: "Cancel" }).click();
+    await confirm.waitFor({ state: "hidden" });
+    await page.getByText("remote-b", { exact: true }).waitFor();
+    assert.equal(calls.filter(({ action }) => action === "clearModels").length, 0);
+
+    await clearModels.click();
+    await confirm.getByTestId("confirm-dialog-confirm").click();
+    await clearModels.waitFor({ state: "hidden" });
+    assert.equal(await page.getByText("remote-b", { exact: true }).count(), 0);
+    assert.equal(await baseUrl.inputValue(), initialBaseUrl);
+    assert.equal(await apiKey.inputValue(), initialApiKey);
+    assert.deepEqual(calls, [
+      { action: "listRemoteModels", payload: "fixture" },
+      { action: "importRemoteModels", payload: { providerId: "fixture", modelIds: ["remote-b"] } },
+      { action: "clearModels", payload: "fixture" },
+    ]);
+  } finally {
+    await page.close();
+  }
+});
