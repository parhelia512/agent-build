diff --git a/apps/zcode-cli/packages/core/src/runtime/methods/compact-model.ts b/apps/zcode-cli/packages/core/src/runtime/methods/compact-model.ts
new file mode 100644
index 00000000..6b2cc049
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/runtime/methods/compact-model.ts
@@ -0,0 +1,88 @@
+import { getAutoCompactThreshold } from "../deps.js";
+import type { AutoCompactPolicyConfig, Model, ModelSelection } from "../deps.js";
+import type { AgentRuntimeInternal } from "../internal.js";
+import { resolveNormalRequestMaxOutputTokens } from "./model-token-limits.js";
+import { createTurnModel } from "./turn-model.js";
+
+// 自动压缩每个 model step 都会解析一次；同一失效选择只告警一次，避免刷屏。
+const warnedUnavailableSelections = new WeakMap<AgentRuntimeInternal, string>();
+
+/**
+ * 创建独立压缩模型；未配置或不可用时返回 undefined，由调用方沿用会话模型。
+ * 未指定或当前模型不支持的推理强度按模型默认档位补齐，否则 Registry 校验会拒绝整个选择。
+ */
+export function resolveCompactModel(
+  runtime: AgentRuntimeInternal,
+  selection: ModelSelection | undefined = runtime.compactModelSelection,
+): Model | undefined {
+  if (!selection) return undefined;
+  try {
+    return createTurnModel(runtime, {
+      selection: completeCompactReasoningLevel(runtime, selection),
+    });
+  } catch (error) {
+    const reasoningLevel = selection.options?.reasoningLevel ?? "";
+    const key = `${selection.providerId}/${selection.modelId}/${reasoningLevel}`;
+    if (warnedUnavailableSelections.get(runtime) === key) return undefined;
+    warnedUnavailableSelections.set(runtime, key);
+    runtime.logger?.warn("Context compression model unavailable; using session model", {
+      error: error instanceof Error ? error.message : String(error),
+      modelId: selection.modelId,
+      providerId: selection.providerId,
+      sessionId: runtime.sessionId,
+    });
+    return undefined;
+  }
+}
+
+function completeCompactReasoningLevel(
+  runtime: AgentRuntimeInternal,
+  selection: ModelSelection,
+): ModelSelection {
+  const entry = runtime.modelCatalogPort
+    ?.listModels()
+    .find(
+      (candidate) =>
+        candidate.providerId === selection.providerId && candidate.modelId === selection.modelId,
+    );
+  if (!entry?.defaultReasoningLevel) return selection;
+  const reasoningLevel = selection.options?.reasoningLevel;
+  if (reasoningLevel !== undefined && entry.reasoningLevels.includes(reasoningLevel)) {
+    return selection;
+  }
+  return {
+    ...selection,
+    options: { ...selection.options, reasoningLevel: entry.defaultReasoningLevel },
+  };
+}
+
+/**
+ * 自动压缩触发时整段上下文要发给压缩模型，阈值必须同时落在会话模型和压缩模型的窗口内，
+ * 否则压缩模型窗口更小时，压缩请求本身就会超窗。
+ */
+export function buildAutoCompactPolicyConfig(
+  runtime: AgentRuntimeInternal,
+  sessionModel: Model,
+  compactModel: Model | undefined,
+): AutoCompactPolicyConfig {
+  const sessionConfig = policyConfigForModel(runtime, sessionModel);
+  if (!compactModel || compactModel === sessionModel) return sessionConfig;
+  const compactConfig = policyConfigForModel(runtime, compactModel);
+  return getAutoCompactThreshold(compactConfig) < getAutoCompactThreshold(sessionConfig)
+    ? compactConfig
+    : sessionConfig;
+}
+
+function policyConfigForModel(
+  runtime: AgentRuntimeInternal,
+  model: Model,
+): AutoCompactPolicyConfig {
+  return {
+    contextWindow: model.properties.contextWindow,
+    ...runtime.config.compact,
+    maxOutputTokens: resolveNormalRequestMaxOutputTokens({
+      modelMaxOutputTokens: model.optionSpecs.maxOutputTokens.max,
+    }),
+    modelContextBudgetStrategy: runtime.config.modelContextBudgetStrategy,
+  };
+}
