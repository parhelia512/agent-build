index 00000000..a2a7d15b
--- /dev/null
+++ b/packages/shared/src/context-compression.test.ts
@@ -0,0 +1,26 @@
+import { describe, expect, it } from "vitest";
+import {
+  CONTEXT_COMPRESSION_SETTINGS_DEFAULTS,
+  mergeContextCompressionSettingsPatch,
+  resolveContextCompressionSettings,
+} from "@zcode/shared";
+
+describe("context compression settings", () => {
+  it("defaults to the current session model", () => {
+    expect(resolveContextCompressionSettings(undefined)).toEqual(
+      CONTEXT_COMPRESSION_SETTINGS_DEFAULTS,
+    );
+  });
+
+  it("preserves the complete nested object when changing one field", () => {
+    const current = {
+      channel: "custom" as const,
+      customSelection: { providerId: "provider-a", modelId: "model-a" },
+      reasoningLevel: "medium" as const,
+    };
+    expect(mergeContextCompressionSettingsPatch(current, { reasoningLevel: "high" })).toEqual({
+      ...current,
+      reasoningLevel: "high",
+    });
+  });
+});
diff --git a/packages/shared/src/context-compression.ts b/packages/shared/src/context-compression.ts
new file mode 100644
index 00000000..5aa2710e
--- /dev/null
+++ b/packages/shared/src/context-compression.ts
@@ -0,0 +1,54 @@
+import { z } from "zod";
+
+const nonEmptyString = z.string().trim().min(1);
+
+export const contextCompressionChannels = ["auto", "custom"] as const;
+export const contextCompressionChannelSchema = z.enum(contextCompressionChannels);
+export const contextCompressionReasoningLevels = ["default", "low", "medium", "high"] as const;
+export const contextCompressionReasoningLevelSchema = z.enum(contextCompressionReasoningLevels);
+
+const contextCompressionCustomSelectionSchema = z
+  .object({
+    providerId: nonEmptyString,
+    modelId: nonEmptyString,
+  })
+  .strict();
+
+const contextCompressionSettingsObjectSchema = z
+  .object({
+    channel: contextCompressionChannelSchema.default("auto"),
+    customSelection: contextCompressionCustomSelectionSchema.optional(),
+    reasoningLevel: contextCompressionReasoningLevelSchema.default("default"),
+  })
+  .strict();
+
+export type ContextCompressionSettings = z.infer<typeof contextCompressionSettingsObjectSchema>;
+
+export const CONTEXT_COMPRESSION_SETTINGS_DEFAULTS: ContextCompressionSettings = {
+  channel: "auto",
+  reasoningLevel: "default",
+};
+
+export const contextCompressionSettingsSchema = contextCompressionSettingsObjectSchema.default(
+  CONTEXT_COMPRESSION_SETTINGS_DEFAULTS,
+);
+export const contextCompressionSettingsPatchSchema = contextCompressionSettingsObjectSchema.partial();
+
+export function resolveContextCompressionSettings(
+  stored: Partial<ContextCompressionSettings> | null | undefined,
+): ContextCompressionSettings {
+  const defaults = CONTEXT_COMPRESSION_SETTINGS_DEFAULTS;
+  if (!stored) return { ...defaults };
+  return {
+    channel: stored.channel ?? defaults.channel,
+    ...(stored.customSelection ? { customSelection: stored.customSelection } : {}),
+    reasoningLevel: stored.reasoningLevel ?? defaults.reasoningLevel,
+  };
+}
+
+export function mergeContextCompressionSettingsPatch(
+  current: ContextCompressionSettings,
+  patch: Partial<ContextCompressionSettings>,
+): ContextCompressionSettings {
+  return resolveContextCompressionSettings({ ...current, ...patch });
+}
diff --git a/packages/ui/src/settings/ContextCompressionSection.tsx b/packages/ui/src/settings/ContextCompressionSection.tsx
new file mode 100644
index 00000000..c55e7066
--- /dev/null
+++ b/packages/ui/src/settings/ContextCompressionSection.tsx
@@ -0,0 +1,185 @@
+import { useMemo, useState } from "react";
+import {
+  contextCompressionChannels,
+  contextCompressionReasoningLevels,
+  mergeContextCompressionSettingsPatch,
+  resolveContextCompressionSettings,
+  type ContextCompressionSettings,
+} from "@zcode/shared";
+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select.js";
+import { toast } from "@/components/ui/toast.js";
+import { useModelSelectionView } from "@/hooks/useModelSelectionView.js";
+import { useSettings } from "@/hooks/useSettingService.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { logger } from "@/logger.js";
+import { SettingsGroupCard, SettingsRow } from "@/settings/SettingsPageParts.js";
+import { SettingsSegmentedTabs } from "@/settings/SettingsSegmentedTabs.js";
+
+export function ContextCompressionSection({
+  remoteSessionId,
+  remoteTarget,
+  workspaceIdentity,
+  workspacePath,
+}: {
+  remoteSessionId?: string | null;
+  remoteTarget?: unknown;
+  workspaceIdentity?: string;
+  workspacePath?: string | null;
+}) {
+  const { intl } = useZCodeIntl();
+  const { settings, update } = useSettings();
+  const [saving, setSaving] = useState(false);
+  const current = useMemo(
+    () => resolveContextCompressionSettings(settings?.contextCompression),
+    [settings?.contextCompression],
+  );
+  const modelSelectionRead = useModelSelectionView(
+    workspacePath,
+    remoteSessionId,
+    workspaceIdentity,
+    remoteTarget,
+    { selection: null },
+  );
+  const selectionView = modelSelectionRead.state.status === "ready" ? modelSelectionRead.state.view : null;
+  const providers = selectionView?.providers ?? [];
+  const customProvider = providers.find(
+    (provider) => provider.providerId === current.customSelection?.providerId,
+  );
+  const effectiveLabel =
+    current.channel === "auto"
+      ? intl.formatMessage({ id: "settings.contextCompression.effective.followSelection" })
+      : current.customSelection
+        ? `${customProvider?.providerName ?? current.customSelection.providerId} / ${current.customSelection.modelId}`
+        : intl.formatMessage({ id: "settings.contextCompression.effective.unresolved" });
+
+  const write = async (patch: Partial<ContextCompressionSettings>) => {
+    if (!settings) return;
+    setSaving(true);
+    try {
+      await update({ contextCompression: mergeContextCompressionSettingsPatch(current, patch) });
+    } catch (error) {
+      logger.warn("[settings] 上下文压缩设置保存失败", { error: String(error) });
+      toast(intl.formatMessage({ id: "settings.contextCompression.saveError" }));
+    } finally {
+      setSaving(false);
+    }
+  };
+  const disabled = saving || !settings;
+
+  return (
+    <section className="flex flex-col gap-4">
+      <SettingsGroupCard>
+        <SettingsRow
+          controlLayout="wide"
+          label={intl.formatMessage({ id: "settings.contextCompression.channel.label" })}
+          control={
+            <SettingsSegmentedTabs
+              value={current.channel}
+              items={contextCompressionChannels.map((channel) => ({
+                value: channel,
+                label: intl.formatMessage({ id: `settings.contextCompression.channel.${channel}` }),
+              }))}
+              onValueChange={(channel) => void write({ channel })}
+              disabled={disabled}
+            />
+          }
+        />
+        {current.channel === "custom" ? (
+          <>
+            <SettingsRow
+              controlLayout="wide"
+              label={intl.formatMessage({ id: "settings.contextCompression.channel.provider" })}
+              control={
+                <Select
+                  value={current.customSelection?.providerId ?? ""}
+                  disabled={disabled || providers.length === 0}
+                  onValueChange={(providerId) => {
+                    const provider = providers.find((candidate) => candidate.providerId === providerId);
+                    const firstModel = provider?.models[0]?.modelId;
+                    if (!firstModel) return;
+                    void write({ customSelection: { providerId, modelId: firstModel } });
+                  }}
+                >
+                  <SelectTrigger size="lg" className="w-full min-w-0 sm:w-64">
+                    <SelectValue placeholder={intl.formatMessage({ id: "settings.contextCompression.channel.providerPlaceholder" })} />
+                  </SelectTrigger>
+                  <SelectContent>
+                    {providers.map((provider) => (
+                      <SelectItem key={provider.providerId} value={provider.providerId}>
+                        {provider.providerName}
+                      </SelectItem>
+                    ))}
+                  </SelectContent>
+                </Select>
+              }
+            />
+            <SettingsRow
+              controlLayout="wide"
+              label={intl.formatMessage({ id: "settings.contextCompression.channel.model" })}
+              control={
+                <Select
+                  value={customProvider ? (current.customSelection?.modelId ?? "") : ""}
+                  disabled={disabled || !customProvider}
+                  onValueChange={(modelId) => {
+                    const providerId = current.customSelection?.providerId;
+                    if (providerId) void write({ customSelection: { providerId, modelId } });
+                  }}
+                >
+                  <SelectTrigger size="lg" className="w-full min-w-0 sm:w-64">
+                    <SelectValue placeholder={intl.formatMessage({ id: "settings.contextCompression.channel.modelPlaceholder" })} />
+                  </SelectTrigger>
+                  <SelectContent>
+                    {(customProvider?.models ?? []).map((model) => (
+                      <SelectItem key={model.modelId} value={model.modelId}>{model.modelId}</SelectItem>
+                    ))}
+                  </SelectContent>
+                </Select>
+              }
+            />
+        {current.channel === "auto" ? (
+          <SettingsRow
+            controlLayout="wide"
+            label={intl.formatMessage({ id: "settings.contextCompression.reasoning.label" })}
+            description={intl.formatMessage({ id: "settings.contextCompression.reasoning.note" })}
+            control={
+              <span className="text-ui-base text-foreground-subtle">
+                {intl.formatMessage({ id: "settings.contextCompression.reasoning.followSession" })}
+              </span>
+            }
+          />
+        ) : (
+          <SettingsRow
+            controlLayout="wide"
+            label={intl.formatMessage({ id: "settings.contextCompression.reasoning.label" })}
+            description={intl.formatMessage({ id: "settings.contextCompression.reasoning.note" })}
+            control={
+              <Select
+                value={current.reasoningLevel}
+                disabled={disabled}
+                onValueChange={(reasoningLevel) =>
+                  void write({ reasoningLevel: reasoningLevel as ContextCompressionSettings["reasoningLevel"] })
+                }
+              >
+                <SelectTrigger size="lg" className="w-full min-w-0 sm:w-64"><SelectValue /></SelectTrigger>
+                <SelectContent>
+                  {contextCompressionReasoningLevels.map((level) => (
+                    <SelectItem key={level} value={level}>
+                      {intl.formatMessage({ id: `settings.contextCompression.reasoning.${level}` })}
+                    </SelectItem>
+                  ))}
+                </SelectContent>
+              </Select>
+            }
+          />
+        )}
+          </>
+        ) : null}
+        <SettingsRow
+          controlLayout="wide"
+          label={intl.formatMessage({ id: "settings.contextCompression.effective.label" })}
+          control={<span className="min-w-0 break-words text-right text-ui-base text-foreground-subtle">{effectiveLabel}</span>}
+        />
+      </SettingsGroupCard>
+    </section>
+  );
+}
