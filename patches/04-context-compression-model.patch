diff --git a/packages/shared/src/context-compression.ts b/packages/shared/src/context-compression.ts
new file mode 100644
index 00000000..b326a014
--- /dev/null
+++ b/packages/shared/src/context-compression.ts
@@ -0,0 +1,67 @@
+import { z } from "zod";
+import type { ModelSelection } from "./model-selection.js";
+
+const nonEmptyString = z.string().trim().min(1);
+
+export const contextCompressionChannels = ["auto", "custom"] as const;
+export const contextCompressionChannelSchema = z.enum(contextCompressionChannels);
+export const contextCompressionReasoningLevelSchema = z.string().trim().min(1);
+
+const contextCompressionCustomSelectionSchema = z
+  .object({
+    providerId: nonEmptyString,
+    modelId: nonEmptyString,
+  })
+  .strict();
+
+const contextCompressionSettingsObjectSchema = z
+  .object({
+    channel: contextCompressionChannelSchema.default("auto"),
+    customSelection: contextCompressionCustomSelectionSchema.optional(),
+    reasoningLevel: contextCompressionReasoningLevelSchema.default("default"),
+  })
+  .strict();
+
+export type ContextCompressionSettings = z.infer<typeof contextCompressionSettingsObjectSchema>;
+
+export const CONTEXT_COMPRESSION_SETTINGS_DEFAULTS: ContextCompressionSettings = {
+  channel: "auto",
+  reasoningLevel: "default",
+};
+
+export const contextCompressionSettingsSchema = contextCompressionSettingsObjectSchema.default(
+  CONTEXT_COMPRESSION_SETTINGS_DEFAULTS,
+);
+export const contextCompressionSettingsPatchSchema = contextCompressionSettingsObjectSchema.partial();
+
+export function resolveContextCompressionSettings(
+  stored: Partial<ContextCompressionSettings> | null | undefined,
+): ContextCompressionSettings {
+  const defaults = CONTEXT_COMPRESSION_SETTINGS_DEFAULTS;
+  if (!stored) return { ...defaults };
+  return {
+    channel: stored.channel ?? defaults.channel,
+    ...(stored.customSelection ? { customSelection: stored.customSelection } : {}),
+    reasoningLevel: stored.reasoningLevel ?? defaults.reasoningLevel,
+  };
+}
+
+export function mergeContextCompressionSettingsPatch(
+  current: ContextCompressionSettings,
+  patch: Partial<ContextCompressionSettings>,
+): ContextCompressionSettings {
+  return resolveContextCompressionSettings({ ...current, ...patch });
+}
+
+/** 独立压缩通道的模型选择；自动通道或未选模型时返回 undefined，沿用会话模型。 */
+export function resolveContextCompressionModelSelection(
+  settings: ContextCompressionSettings | null | undefined,
+): ModelSelection | undefined {
+  if (settings?.channel !== "custom" || !settings.customSelection) return undefined;
+  const { customSelection, reasoningLevel } = settings;
+  return {
+    ...customSelection,
+    // 推理强度由压缩模型决定，会话模型支持的强度不能用于过滤独立模型的配置。
+    ...(reasoningLevel === "default" ? {} : { options: { reasoningLevel } }),
+  };
+}
